{
  "name": "defi_server",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.ts",
    "build": "bun build ./index.ts --outdir ./build --target bun",
    "generate": "protoc -I../proto --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop ../proto/*.proto",
    "test": "bun test"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@privy-io/server-auth": "^1.27.4",
    "@supabase/supabase-js": "^2.50.2",
    "axios": "^1.10.0",
    "dotenv": "^16.5.0",
    "ethers": "^6.14.4",
    "install": "^0.13.0",
    "node-fetch": "^3.3.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "ts-proto": "^2.7.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.15.33",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5.7.3"
  }
}
